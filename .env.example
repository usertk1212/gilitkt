# Copy this file to .env.local and fill in the two IDs from your Appwrite project.
# See SETUP_APPWRITE.md for where to find them.
#
# These are read at BUILD time, not at runtime — Vite inlines them into the
# bundle. Changing them means rebuilding (locally) or redeploying (on Vercel).
# They are not secrets: a public Appwrite project ID and database ID are visible
# to any browser that loads the app. Access is controlled by table permissions
# and the platform/CORS allowlist, not by hiding these values.

# Project → Settings → Project ID
VITE_APPWRITE_PROJECT_ID=

# Databases → your database → Database ID
VITE_APPWRITE_DATABASE_ID=

# Only change this if you self-host Appwrite instead of using Appwrite Cloud.
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
